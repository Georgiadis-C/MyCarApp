<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:MyCarApp.ViewModels"
             xmlns:model="clr-namespace:MyCarApp.Models"
             x:DataType="viewmodel:MaintainDetailsViewModel"
             x:Class="MyCarApp.Views.MaintainDetailsPage"
             Shell.BackgroundColor="#008080">

    <Grid>
        <BoxView>
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#008080" Offset="0.0" />
                    <GradientStop Color="#F5F5F5" Offset="0.5" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <ScrollView Padding="20">
            <VerticalStackLayout Spacing="15">

                <Border StrokeShape="RoundRectangle 15" Padding="20" BackgroundColor="White">
                    <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                        <Label Text="{Binding Maintain.Date, StringFormat='{0:dd/MM/yyyy}', FallbackValue='00/00/0000'}" 
                               FontSize="24" FontAttributes="Bold" TextColor="Teal" HorizontalOptions="Center"/>
                        <Label Text="Record Date" TextColor="Gray" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <Border StrokeShape="RoundRectangle 15" Padding="20" BackgroundColor="White">
                    <VerticalStackLayout Spacing="15">
                        <Label Text="Work performed" FontAttributes="Bold" TextColor="Teal" Margin="0,0,0,5"/>

                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Oil Change" VerticalOptions="Center" FontSize="16"/>
                            <Label Grid.Column="1" FontSize="18">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding Maintain.ChangedOil, FallbackValue=False}" Value="True">
                                        <Setter Property="Text" Value="✅" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding Maintain.ChangedOil, FallbackValue=False}" Value="False">
                                        <Setter Property="Text" Value="❌" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Grid>
                        <BoxView HeightRequest="1" Color="#F0F0F0"/>

                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Oil Filter Change" VerticalOptions="Center" FontSize="16"/>
                            <Label Grid.Column="1" FontSize="18">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding Maintain.ChangedOilFilter, FallbackValue=False}" Value="True">
                                        <Setter Property="Text" Value="✅" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding Maintain.ChangedOilFilter, FallbackValue=False}" Value="False">
                                        <Setter Property="Text" Value="❌" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Grid>
                        <BoxView HeightRequest="1" Color="#F0F0F0"/>

                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Air Filter Change" VerticalOptions="Center" FontSize="16"/>
                            <Label Grid.Column="1" FontSize="18">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding Maintain.ChangedAirFilter, FallbackValue=False}" Value="True">
                                        <Setter Property="Text" Value="✅" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding Maintain.ChangedAirFilter, FallbackValue=False}" Value="False">
                                        <Setter Property="Text" Value="❌" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Grid>
                        <BoxView HeightRequest="1" Color="#F0F0F0"/>

                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Ignition Coil Change" VerticalOptions="Center" FontSize="16"/>
                            <Label Grid.Column="1" FontSize="18">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding Maintain.ChangedIgnitionCoil, FallbackValue=False}" Value="True">
                                        <Setter Property="Text" Value="✅" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding Maintain.ChangedIgnitionCoil, FallbackValue=False}" Value="False">
                                        <Setter Property="Text" Value="❌" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Grid>
                        <BoxView HeightRequest="1" Color="#F0F0F0"/>

                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Fuel Filter Change" VerticalOptions="Center" FontSize="16"/>
                            <Label Grid.Column="1" FontSize="18">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding Maintain.ChangedFuelFilter, FallbackValue=False}" Value="True">
                                        <Setter Property="Text" Value="✅" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding Maintain.ChangedFuelFilter, FallbackValue=False}" Value="False">
                                        <Setter Property="Text" Value="❌" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="10" Margin="0,10,0,0">
                    <Button Text="UPDATE" 
                            Command="{Binding GoToUpdateMaintainCommand}"
                            BackgroundColor="Teal" TextColor="White" CornerRadius="25" HeightRequest="50"/>

                    <Button Text="DELETE" 
                            Command="{Binding DeleteMaintainCommand}"
                            BackgroundColor="DarkRed" TextColor="White" CornerRadius="25" HeightRequest="50"/>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>