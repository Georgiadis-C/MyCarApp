<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyCarApp.Views.TripDetailsPage"
             xmlns:local="clr-namespace:MyCarApp.ViewModels"
             x:DataType="local:TripDetailsViewModel"
             Shell.BackgroundColor="#008080">
    <ContentPage.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#008080" Offset="0.0" />
                    <GradientStop Color="#E8F1F2" Offset="0.7" />
                    <GradientStop Color="#E8F1F2" Offset="1.0" />
            </LinearGradientBrush>
        </ContentPage.Background>

    <VerticalStackLayout Padding="25" Spacing="20">
        <Label Text="Trip Information" FontSize="24" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>

        <Border BackgroundColor="White" Padding="20">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="25"/>
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="15">
                <Label Text="Route" FontAttributes="Bold" TextColor="#008080"/>
                <Label Text="{Binding Trip.StartingPoint, StringFormat='Από: {0}'}" TextColor="Black" FontSize="16"/>
                <Label Text="{Binding Trip.Destination, StringFormat='Προς: {0}'}" TextColor="Black" FontSize="16"/>

                <BoxView HeightRequest="1" Color="#F0F0F0" />

                <Label Text="Kilometers" FontAttributes="Bold" TextColor="#008080"/>
                <Label Text="{Binding Trip.Kilometers, StringFormat='{0} km'}" TextColor="Black" FontSize="18"/>

                <Label Text="Date" FontAttributes="Bold" TextColor="#008080"/>
                <Label Text="{Binding Trip.Date, StringFormat='{0:dd/MM/yyyy}'}" TextColor="Black" FontSize="16"/>
            </VerticalStackLayout>
        </Border>

        <Button Text="Update" Command="{Binding GoToUpdateTripCommand}" 
                BackgroundColor="#008080" TextColor="White" 
                CornerRadius="25" HeightRequest="55"/>

        <Button Text="Delete" Command="{Binding DeleteTripCommand}" 
                 BackgroundColor="DarkRed" TextColor="White" FontAttributes="Bold" Margin="0,10,0,0" CornerRadius="25" HeightRequest="55"/>
    </VerticalStackLayout>
</ContentPage>