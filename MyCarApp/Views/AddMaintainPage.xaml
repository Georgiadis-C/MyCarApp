<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:MyCarApp.ViewModels"
             x:DataType="viewmodel:AddMaintainViewModel"
             x:Class="MyCarApp.Views.AddMaintainPage"
             BackgroundColor="#F5F5F5">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="White" Offset="0.1" />
            <GradientStop Color="#008080" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="15">

            <Border StrokeShape="RoundRectangle 10" Padding="15" BackgroundColor="White">
                <VerticalStackLayout Spacing="10">

                    <Label Text="Date" FontSize="12" TextColor="Gray"/>
                    <DatePicker Date="{Binding Service.Date}" TextColor="Black"/>
                </VerticalStackLayout>
            </Border>

            <Border StrokeShape="RoundRectangle 10" Padding="15" BackgroundColor="White">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Maintenance Work" FontAttributes="Bold" TextColor="Teal" FontSize="16" Margin="0,0,0,5"/>

                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Oil Change" VerticalOptions="Center" TextColor="Black"/>
                        <Switch Grid.Column="1" IsToggled="{Binding Service.ChangedOil, Mode=TwoWay}" OnColor="Teal"/>
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Oil filter change" VerticalOptions="Center" TextColor="Black"/>
                        <Switch Grid.Column="1" IsToggled="{Binding Service.ChangedOilFilter, Mode=TwoWay}" OnColor="Teal"/>
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Air filter change" VerticalOptions="Center" TextColor="Black"/>
                        <Switch Grid.Column="1" IsToggled="{Binding Service.ChangedAirFilter, Mode=TwoWay}" OnColor="Teal"/>
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Fuel filter change" VerticalOptions="Center" TextColor="Black"/>
                        <Switch Grid.Column="1" IsToggled="{Binding Service.ChangedFuelFilter, Mode=TwoWay}" OnColor="Teal"/>
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Ignition coil change" VerticalOptions="Center" TextColor="Black"/>
                        <Switch Grid.Column="1" IsToggled="{Binding Service.ChangedIgnitionCoil, Mode=TwoWay}" OnColor="Teal"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Button Text="SAVE" 
                    Command="{Binding SaveCarMaintainCommand}"
                    BackgroundColor="Teal" 
                    TextColor="White" 
                    CornerRadius="25"
                    HeightRequest="55"
                    FontAttributes="Bold"
                    Margin="0,15,0,10">
                <Button.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Opacity="0.2" Radius="5"/>
                </Button.Shadow>
            </Button>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>