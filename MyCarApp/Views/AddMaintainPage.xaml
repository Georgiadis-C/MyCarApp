<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:MyCarApp.ViewModels"
             x:DataType="viewmodel:AddMaintainViewModel"
             x:Class="MyCarApp.Views.AddMaintainPage"
             Title="Προσθήκη Service"
             BackgroundColor="#F5F5F5">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="15">

            <Border StrokeShape="RoundRectangle 10" Padding="15" BackgroundColor="White">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Βασικές Πληροφορίες" FontAttributes="Bold" TextColor="Teal" FontSize="16"/>
                    <BoxView HeightRequest="1" Color="#E0E0E0" Margin="0,5"/>

                    <Label Text="Ημερομηνία" FontSize="12" TextColor="Gray"/>
                    <DatePicker Date="{Binding Date}" TextColor="Black"/>
                </VerticalStackLayout>
            </Border>

            <Border StrokeShape="RoundRectangle 10" Padding="15" BackgroundColor="White">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Εργασίες Συντήρησης" FontAttributes="Bold" TextColor="Teal" FontSize="16" Margin="0,0,0,5"/>

                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Αλλαγή Λαδιών" VerticalOptions="Center" TextColor="Black"/>
                        <Switch Grid.Column="1" IsChecked="{Binding IsOilChanged}" OnColor="Teal"/>
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Αλλαγή Φίλτρων" VerticalOptions="Center" TextColor="Black"/>
                        <Switch Grid.Column="1" IsChecked="{Binding IsFiltersChanged}" OnColor="Teal"/>
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Έλεγχος Φρένων" VerticalOptions="Center" TextColor="Black"/>
                        <Switch Grid.Column="1" IsChecked="{Binding IsBrakesChecked}" OnColor="Teal"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Button Text="ΑΠΟΘΗΚΕΥΣΗ" 
                    Command="{Binding SaveMaintainCommand}"
                    BackgroundColor="Teal" 
                    TextColor="White" 
                    CornerRadius="25"
                    HeightRequest="55"
                    FontAttributes="Bold"
                    Margin="0,15,0,10">
                <Button.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Opacity="0.2" Radius="5"/>
                </Button.Shadow>
            </Button>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>