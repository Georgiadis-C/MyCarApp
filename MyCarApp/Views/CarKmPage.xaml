<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyCarApp.Views.CarKmPage"
             xmlns:vm="clr-namespace:MyCarApp.ViewModels"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
             xmlns:models="clr-namespace:MyCarApp.Models"
             xmlns:components="clr-namespace:MyCarApp.Components"
             x:DataType="vm:CarKmViewModel"
             x:Name="thisPage">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="White" Offset="0.1" />
            <GradientStop Color="#008080" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="Auto, 400, Auto, *" Padding="10" RowSpacing="5">

        <VerticalStackLayout Grid.Row="0">
            <Label Text="{Binding Car.Brand, StringFormat='Car: {0}'}" 
                   FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"/>
            <Label Text="{Binding TotalKilometers, StringFormat='Total Kilometers: {0:F2} km'}" 
                   FontSize="16" TextColor="Gray" HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <Border Grid.Row="1" 
                Stroke="#D0D0D0" 
                StrokeThickness="2" 
                StrokeShape="RoundRectangle 20"
                HorizontalOptions="Fill" 
                VerticalOptions="Fill"
                Padding="0">

            <mapsui:MapView x:Name="MyMap" 
                            Map="{Binding Map}"
                            Info="MyMap_Info" />
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*, Auto, Auto" Margin="0,10" Padding="5">
            <Label Text="{Binding DistanceResult, StringFormat='Distance: {0}'}"  
                   Grid.Column="0"
                   FontSize="18" TextColor="#2196F3" FontAttributes="Bold" 
                   VerticalOptions="Center"/>
            <Button Grid.Column="2" Text="Clear" 
                    Command="{Binding ClearMapCommand}" 
                    BackgroundColor="#FF5252" TextColor="White" 
                    CornerRadius="10"/>
        </Grid>

        <CollectionView Grid.Row="3" 
                        ItemsSource="{Binding KmLogs}" 
                        SelectionMode="Single"
                        SelectionChanged="OnHistorySelectionChanged">

            <CollectionView.Header>
                <Label Text="Trips History" FontSize="16" FontAttributes="Bold" Margin="10,5"/>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CarKmModel" >
                    <Border Margin="10,5" Padding="15" Stroke="#EEEEEE" StrokeShape="RoundRectangle 10" BackgroundColor="White">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding BindingContext.ShowRouteFromHistoryCommand, Source={x:Reference thisPage}}" 
                                                  CommandParameter="{Binding .}"/>
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <Label Grid.Column="0" Text="🏁" FontSize="24" VerticalOptions="Center"/>

                            <VerticalStackLayout Grid.Column="1" Margin="15,0,0,0" VerticalOptions="Center">
                                <Label Text="{Binding StartingPoint, StringFormat='Από: {0}'}" FontAttributes="Bold" FontSize="14"/>
                                <Label Text="{Binding Destination, StringFormat='Προς: {0}'}" FontAttributes="Bold" FontSize="14"/>
                                <Label Text="{Binding Date, StringFormat='{0:dd/MM/yyyy HH:mm}'}" FontSize="12" TextColor="Gray"/>

                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="{Binding Kilometers, StringFormat='{0:F2} km'}" FontSize="13" TextColor="#4CAF50" FontAttributes="Bold"/>
                                    <Label Text="|" TextColor="LightGray"/>
                                    <Label Text="{Binding FuelConsumed, StringFormat='{0:F2} L'}" FontSize="13" TextColor="#E91E63" FontAttributes="Bold"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <Button Grid.Column="2" 
                                    Text="🗑" 
                                    BackgroundColor="Transparent" 
                                    TextColor="Red"
                                    FontSize="20"
                                    Command="{Binding BindingContext.DeleteTripCommand, Source={x:Reference thisPage}}"
                                    CommandParameter="{Binding .}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <components:LoadingOverlay Grid.Row="0" 
                                   Grid.RowSpan="4" 
                                   IsVisible="{Binding IsBusy}" 
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Fill"
                                   BackgroundColor="#AA000000"/>
    </Grid>
</ContentPage>