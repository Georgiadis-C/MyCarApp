<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
             xmlns:local="clr-namespace:MyCarApp.ViewModels"
             xmlns:models="clr-namespace:MyCarApp.Models"
             x:DataType="local:CarKmViewModel"
             x:Class="MyCarApp.Views.CarKmPage"
             Shell.BackgroundColor="White">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="White" Offset="0.1" />
            <GradientStop Color="#008080" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="Auto, *, Auto">
        <VerticalStackLayout Grid.Row="0" Padding="25,20">
            <Label Text="{Binding Car.Brand}" FontSize="28" FontAttributes="Bold" TextColor="#008080"/>
            <Label Text="Total Kilometers:" TextColor="#666666"/>
            <Label Text="{Binding TotalKilometers, StringFormat='{0:N1} km'}" 
                   FontSize="32" 
                   FontAttributes="Bold" 
                   TextColor="#008080"/>
        </VerticalStackLayout>
        

        <CollectionView Grid.Row="1" 
                        ItemsSource="{Binding KmLogs}" 
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CarKmModel">
                    <Grid Padding="20,5">
                        <Border BackgroundColor="#008080" Padding="15">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20"/>
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer 
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type local:CarKmViewModel}}, Path=SelectTripCommand}"
                                    CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="*, Auto">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Date, StringFormat='{0:dd/MM/yyyy}'}" 
                                           TextColor="#B2DFDB" 
                                           FontSize="11" 
                                           FontAttributes="Bold"/>

                                    <HorizontalStackLayout Spacing="5" Margin="0,2">
                                        <Label Text="{Binding StartingPoint}" 
                                               TextColor="White" 
                                               FontSize="16" 
                                               FontAttributes="Bold"/>
                                        <Label Text="➔" 
                                               TextColor="#B2DFDB" 
                                               VerticalOptions="Center"/>
                                        <Label Text="{Binding Destination}" 
                                               TextColor="White" 
                                               FontSize="16" 
                                               FontAttributes="Bold"/>
                                    </HorizontalStackLayout>

                                    <Label Text="{Binding Kilometers, StringFormat='{0:N1} km'}" 
                                           TextColor="White" 
                                           FontSize="18" />
                                </VerticalStackLayout>

                                <Label Grid.Column="1" Text="🏁" VerticalOptions="Center" FontSize="28"/>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="2" Text="ADD NEW TRIP"
                Command="{Binding GoToAddTripCommand}"
                Margin="25" BackgroundColor="#008080" TextColor="White"
                CornerRadius="25" HeightRequest="55" FontAttributes="Bold"/>
    </Grid>
</ContentPage>