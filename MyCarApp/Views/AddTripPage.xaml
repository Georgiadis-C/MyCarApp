<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyCarApp.Views.AddTripPage"
             xmlns:local="clr-namespace:MyCarApp.ViewModels"
             x:DataType="local:AddTripViewModel"
             Title="New Record">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="White" Offset="0.1" />
            <GradientStop Color="#008080" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <VerticalStackLayout Padding="25" Spacing="20">
        <Label Text="Enter Kilometers" FontSize="24" 
               FontAttributes="Bold" TextColor="#008080" HorizontalOptions="Center"/>

        <Border BackgroundColor="White" Padding="20">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="25"/>
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="15">
                <Label Text="Total Kilometers" TextColor="#008080" FontAttributes="Bold"/>
                <Entry Text="{Binding NewTrip.Kilometers}" 
                       Placeholder="π.χ. 15400" 
                       Keyboard="Numeric"
                       TextColor="Black"/>
            </VerticalStackLayout>
        </Border>

        <Button Text="Save"
                Command="{Binding SaveTripCommand}"
                BackgroundColor="#008080" TextColor="White"
                CornerRadius="25" HeightRequest="55" FontAttributes="Bold"/>
    </VerticalStackLayout>
</ContentPage>