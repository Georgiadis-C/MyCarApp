<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyCarApp.Views.AddCarPage"
             xmlns:local="clr-namespace:MyCarApp.ViewModels"
             x:DataType="local:AddCarViewModel"
             Title="AddCarPage">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Car Details" 
                   FontSize="22" 
                   FontAttributes="Bold" 
                   TextColor="#333"
                   Margin="0,0,0,10"/>

            <Label Text="Brand" FontSize="14" Margin="5,0"/>
            <Border Stroke="#D0D0D0" StrokeThickness="1" Padding="10,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8"/>
                </Border.StrokeShape>
                <Entry Text="{Binding Car.Brand}" Placeholder="Toyota" />
            </Border>

            <Label Text="Model" FontSize="14" Margin="5,0"/>
            <Border Stroke="#D0D0D0" StrokeThickness="1" Padding="10,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8"/>
                </Border.StrokeShape>
                <Entry Text="{Binding Car.Model}" Placeholder="Corolla" />
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                <VerticalStackLayout Grid.Column="0" Spacing="5">
                    <Label Text="Year" FontSize="14" Margin="5,0"/>
                    <Border Stroke="#D0D0D0" StrokeThickness="1" Padding="10,0">
                        <Border.StrokeShape>
                            <RoundRectangle/>
                        </Border.StrokeShape>
                        <Entry Text="{Binding Car.Year}" Keyboard="Numeric" Placeholder="2006" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="5">
                    <Label Text="HorsePower (HP)" FontSize="14" Margin="5,0"/>
                    <Border Stroke="#D0D0D0" StrokeThickness="1" Padding="10,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <Entry Text="{Binding Car.Horsepower}" Keyboard="Numeric" Placeholder="100" />
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <Label Text="Cubic Centimeters (CC)" FontSize="14" Margin="5,0"/>
            <Border Stroke="#D0D0D0" StrokeThickness="1" Padding="10,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8"/>
                </Border.StrokeShape>
                <Entry Text="{Binding Car.CubicCentimeters}" Keyboard="Numeric" Placeholder="1400" />
            </Border>

            <Button Text="Αποθήκευση"
                    Command="{Binding SaveCarCommand}"
                    BackgroundColor="#512BD4"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="50"
                    Margin="0,20,0,0"
                    FontAttributes="Bold"
                    FontSize="16"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>