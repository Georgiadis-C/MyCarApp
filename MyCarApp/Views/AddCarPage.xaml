<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyCarApp.Views.AddCarPage"
             xmlns:local="clr-namespace:MyCarApp.ViewModels"
             x:DataType="local:AddCarViewModel"
             Shell.BackgroundColor="White">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="White" Offset="0.1" />
            <GradientStop Color="#008080" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="20">

            <Border BackgroundColor="#008080"
                    HeightRequest="80"
                    WidthRequest="80"
                    HorizontalOptions="Center"
                    StrokeThickness="0"
                    Margin="0,20,0,10">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="40"/>
                </Border.StrokeShape>
                <Label Text="➕" FontSize="35" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>

            <Label Text="New Vehicle" 
                   FontSize="26" 
                   FontAttributes="Bold" 
                   TextColor="#008080" 
                   HorizontalOptions="Center"/>

            <Border BackgroundColor="White" 
                    Padding="20" 
                    StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="25"/>
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="15">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Brand" TextColor="#008080" FontAttributes="Bold" Margin="5,0"/>
                        <Entry Text="{Binding Car.Brand}" 
                               Placeholder="e.g. Toyota"
                               TextColor="Black"
                               PlaceholderColor="#A0A0A0"/>
                        <Label Text="{Binding BrandError}" TextColor="Red" Margin="5,0" IsVisible="{Binding BrandError, Converter={StaticResource StringNotEmptyToBoolConverter}}"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Model" TextColor="#008080" FontAttributes="Bold" Margin="5,0"/>
                        <Entry Text="{Binding Car.Model}" 
                               Placeholder="e.g. Corolla"
                               TextColor="Black"/>
                        <Label Text="{Binding ModelError}" TextColor="Red" Margin="5,0" IsVisible="{Binding ModelError, Converter={StaticResource StringNotEmptyToBoolConverter}}"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Year" TextColor="#008080" FontAttributes="Bold" Margin="5,0"/>
                        <Entry Text="{Binding Car.Year}" 
                               Placeholder="e.g. 2022"
                               Keyboard="Numeric"
                               TextColor="Black"/>
                        <Label Text="{Binding YearError}" TextColor="Red" Margin="5,0" IsVisible="{Binding YearError, Converter={StaticResource StringNotEmptyToBoolConverter}}"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Horsepower" TextColor="#008080" FontAttributes="Bold" Margin="5,0"/>
                        <Entry Text="{Binding Car.Horsepower}" 
                               Placeholder="e.g. 200"
                               Keyboard="Numeric"
                               TextColor="Black"/>
                        <Label Text="{Binding HorsepowerError}" TextColor="Red" Margin="5,0" IsVisible="{Binding HorsepowerError, Converter={StaticResource StringNotEmptyToBoolConverter}}"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Cubic Centimeters" TextColor="#008080" FontAttributes="Bold" Margin="5,0"/>
                        <Entry Text="{Binding Car.CubicCentimeters}" 
                               Placeholder="e.g. 2000"
                               Keyboard="Numeric"
                               TextColor="Black"/>
                        <Label Text="{Binding CcError}" TextColor="Red" Margin="5,0" IsVisible="{Binding CcError, Converter={StaticResource StringNotEmptyToBoolConverter}}"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Fuel Consumption" TextColor="#008080" FontAttributes="Bold" Margin="5,0"/>
                        <Entry Text="{Binding Car.FuelConsumption}" 
                               Placeholder="e.g. 7.2"
                               Keyboard="Numeric"
                               TextColor="Black"/>
                        <Label Text="{Binding FuelConsError}" TextColor="Red" Margin="5,0" IsVisible="{Binding FuelConsError, Converter={StaticResource StringNotEmptyToBoolConverter}}"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Button Text="Save"
                    Command="{Binding SaveCarCommand}"
                    BackgroundColor="#008080"
                    TextColor="White"
                    FontAttributes="Bold"
                    HeightRequest="55"
                    CornerRadius="25"
                    Margin="0,10,0,0"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>