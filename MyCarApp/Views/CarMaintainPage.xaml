<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyCarApp.Views.CarMaintainPage"
             xmlns:viewmodel="clr-namespace:MyCarApp.ViewModels"
             xmlns:model="clr-namespace:MyCarApp.Models"
             xmlns:components="clr-namespace:MyCarApp.Components"
             x:DataType="viewmodel:CarMaintainViewModel"
             Title="Car Maintenance">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="White" Offset="0.1" />
            <GradientStop Color="#008080" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="Auto, *, Auto" Padding="20">

        <VerticalStackLayout Grid.Row="0" Spacing="10" Margin="0,0,0,10">

            <Border BackgroundColor="Teal" 
                    StrokeShape="RoundRectangle 15"
                    StrokeThickness="0">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="2,5" Radius="5" Opacity="0.2"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="5" HorizontalOptions="Center" Padding="15">
                    <Label Text="Συνολικά Service" 
                           TextColor="White" 
                           FontSize="14" 
                           HorizontalOptions="Center"/>
                    <Label Text="{Binding TotalMaintains}" 
                           TextColor="White" 
                           FontSize="32" 
                           FontAttributes="Bold" 
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White"
                    Stroke="#FF4444"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    Padding="10">
                <Border.Shadow>
                    <Shadow Brush="Red" Offset="0,2" Radius="3" Opacity="0.1"/>
                </Border.Shadow>

                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding MaintenanceStatusMessage}" Value="">
                        <Setter Property="IsVisible" Value="True" />
                    </DataTrigger>
                </Border.Triggers>

                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Label Text="⚠️" FontSize="18" VerticalOptions="Center"/>
                    <Label Text="{Binding MaintenanceStatusMessage}" 
                           TextColor="Red" 
                           FontAttributes="Bold" 
                           FontSize="11.5"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Border>
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" 
                        ItemsSource="{Binding MaintainLogs}"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                    <Label Text="No Records Found" 
                           TextColor="Gray" 
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="model:CarMaintainModel">
                    <Grid Padding="5">
                        <Border StrokeShape="RoundRectangle 10" 
                                Stroke="#E0E0E0"
                                StrokeThickness="1"
                                Padding="10"
                                BackgroundColor="White">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer 
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:CarMaintainViewModel}}, Path=SelectMaintainCommand}"
                                    CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>

                            <HorizontalStackLayout Spacing="15">
                                <BoxView WidthRequest="5" 
                                         BackgroundColor="Teal" 
                                         VerticalOptions="Fill"
                                         CornerRadius="2"/>

                                <VerticalStackLayout VerticalOptions="Center">
                                    <Label Text="{Binding Date, StringFormat='{0:dd/MM/yyyy}'}" 
                                           FontAttributes="Bold" 
                                           FontSize="16" 
                                           TextColor="Black"/>
                                    <Label Text="{Binding Name}" 
                                           TextColor="Gray" 
                                           FontSize="14"/>
                                </VerticalStackLayout>

                                <Label Text="➔" 
                                       TextColor="Teal"
                                       FontSize="20"
                                       HorizontalOptions="EndAndExpand" 
                                       VerticalOptions="Center"
                                       Margin="0,0,10,0"/>
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="2" 
                Text="Προσθήκη Service" 
                Command="{Binding GoToAddMaintainCommand}"
                BackgroundColor="Teal"    
                TextColor="White" 
                BorderColor="White"
                BorderWidth="1"
                CornerRadius="25"
                HeightRequest="50"
                FontAttributes="Bold"
                Margin="0,10,0,0">
            <Button.Shadow>
                <Shadow Brush="Black" Offset="0,3" Radius="3" Opacity="0.2"/>
            </Button.Shadow>
        </Button>
        <components:LoadingOverlay Grid.Row="0" 
                                   Grid.RowSpan="4" 
                                   IsVisible="{Binding IsBusy}" 
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Fill"
                                   BackgroundColor="#AA000000" />

    </Grid>
</ContentPage>