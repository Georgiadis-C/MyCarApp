<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyCarApp.Views.CarDetailsPage"
             xmlns:local="clr-namespace:MyCarApp.ViewModels"
             x:DataType="local:CarDetailsViewModel"
             Title=""
             BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <Grid HeightRequest="200" BackgroundColor="#512BD4">
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="5">
                    <Label Text="{Binding Car.Brand}" 
                           FontSize="32" 
                           FontAttributes="Bold" 
                           TextColor="White" 
                           HorizontalOptions="Center"/>
                    <Label Text="{Binding Car.Model}" 
                           FontSize="20" 
                           TextColor="#E1E1E1" 
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Grid>

            <Border Margin="20,-40,20,20" 
                    Padding="20" 
                    StrokeShape="RoundRectangle 15"
                    BackgroundColor="White"
                    StrokeThickness="0">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,10" Radius="20" Opacity="0.1" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="15">

                    <Label Text="{Binding Car.Horsepower, StringFormat='{0} HP'}" 
                           FontSize="28" 
                           TextColor="#512BD4"
                           FontAttributes="Bold" 
                           HorizontalOptions="Center" />

                    <BoxView HeightRequest="1" Color="#EEEEEE" HorizontalOptions="Fill" />

                    <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto, Auto" RowSpacing="10" ColumnSpacing="10">

                        <Label Grid.Row="0" Grid.Column="0" Text="Year:" FontAttributes="Bold" TextColor="Gray" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding Car.Year}" HorizontalOptions="End" />

                        <Label Grid.Row="1" Grid.Column="0" Text="Cybic Centimeters:" FontAttributes="Bold" TextColor="Gray" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding Car.CubicCentimeters, StringFormat='{0} cc'}" HorizontalOptions="End" />
                    </Grid>

                    <Button Text="Update" 
                            Margin="0,10,0,0"
                            BackgroundColor="#512BD4" 
                            TextColor="White"
                            CornerRadius="10" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>