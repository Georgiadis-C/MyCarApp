<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyCarApp.Views.CarDetailsPage"
             xmlns:local="clr-namespace:MyCarApp.ViewModels"
             xmlns:locals="clr-namespace:MyCarApp.Models"
             x:DataType="local:CarsViewModel"
             Title="MainCarPage">
    <ScrollView>
        <VerticalStackLayout>
            <Grid ColumnDefinitions="*,Auto,*" RowDefinitions="160, Auto">
                <Grid Grid.ColumnSpan="3" HeightRequest="160" HorizontalOptions="FillAndExpand">
                    <Border Grid.RowSpan="2" Grid.Column="1" Margin="0,80,0,0" HeightRequest="160" WidthRequest="160" HorizontalOptions="Center" Padding="0">

                    </Border>
                </Grid>
            </Grid>

            <VerticalStackLayout x:DataType="locals:CarsModel" Padding="10" Spacing="10">
                <Label Text="{Binding SelectedCar.Horsepower}" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />
                <Label Text="{Binding SelectedCar.Brand}" FontSize="18" HorizontalOptions="Center" />
                <Label Text="{Binding SelectedCar.Model}" FontSize="18" HorizontalOptions="Center" />
                <Label Text="{Binding SelectedCar.Year}" FontSize="18" HorizontalOptions="Center" />
                <Label Text="{Binding SelectedCar.CubicCentimeters}" FontSize="18" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>