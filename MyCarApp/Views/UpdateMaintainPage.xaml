<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:MyCarApp.ViewModels"
             xmlns:model="clr-namespace:MyCarApp.Models"
             x:DataType="viewmodel:UpdateMaintainViewModel"
             x:Class="MyCarApp.Views.UpdateMaintainPage">
    
    
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="White" Offset="0.1" />
            <GradientStop Color="#008080" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid>
        <ScrollView Padding="20">
            <VerticalStackLayout Spacing="15">

                <Border StrokeShape="RoundRectangle 15" Padding="15" BackgroundColor="White">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Service Date" FontAttributes="Bold" TextColor="Teal"/>
                        <DatePicker Date="{Binding Maintain.Date, Mode=TwoWay}" TextColor="Black"/>
                    </VerticalStackLayout>
                </Border>

                <Border StrokeShape="RoundRectangle 15" Padding="20" BackgroundColor="White">
                    <VerticalStackLayout Spacing="15">
                        <Label Text="Update Maintenance" FontAttributes="Bold" TextColor="Teal" Margin="0,0,0,5"/>

                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Oil change" VerticalOptions="Center"/>
                            <Switch Grid.Column="1" IsToggled="{Binding Maintain.ChangedOil, Mode=TwoWay}" OnColor="Teal"/>
                        </Grid>
                        <BoxView HeightRequest="1" Color="#F0F0F0"/>

                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Oil filter change" VerticalOptions="Center"/>
                            <Switch Grid.Column="1" IsToggled="{Binding Maintain.ChangedOilFilter, Mode=TwoWay}" OnColor="Teal"/>
                        </Grid>
                        <BoxView HeightRequest="1" Color="#F0F0F0"/>

                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Air filter change" VerticalOptions="Center"/>
                            <Switch Grid.Column="1" IsToggled="{Binding Maintain.ChangedAirFilter, Mode=TwoWay}" OnColor="Teal"/>
                        </Grid>
                        <BoxView HeightRequest="1" Color="#F0F0F0"/>

                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Ignition coil change" VerticalOptions="Center"/>
                            <Switch Grid.Column="1" IsToggled="{Binding Maintain.ChangedIgnitionCoil, Mode=TwoWay}" OnColor="Teal"/>
                        </Grid>
                        <BoxView HeightRequest="1" Color="#F0F0F0"/>

                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Fuel filter change" VerticalOptions="Center"/>
                            <Switch Grid.Column="1" IsToggled="{Binding Maintain.ChangedFuelFilter, Mode=TwoWay}" OnColor="Teal"/>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <Button Text="SAVE CHANGES" 
                        Command="{Binding UpdateMaintainCommand}"
                        BackgroundColor="Teal" 
                        TextColor="White" 
                        CornerRadius="25" 
                        HeightRequest="55"
                        FontAttributes="Bold"
                        Margin="0,10,0,0">
                    <Button.Shadow>
                        <Shadow Brush="Black" Offset="0,4" Opacity="0.2" Radius="5"/>
                    </Button.Shadow>
                </Button>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>