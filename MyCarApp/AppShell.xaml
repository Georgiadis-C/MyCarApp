<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MyCarApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MyCarApp"
    Title="MyCarApp"
    Shell.TabBarBackgroundColor="Black"
    Shell.TabBarForegroundColor="LightGray"
    Shell.TabBarTitleColor="LightGray">

    <TabBar>
        <Tab Title="Car Page">
            <ShellContent 
            ContentTemplate="{DataTemplate views:CarPage}" />
        </Tab>

        <Tab Title="Car Kilometers">
            <ShellContent 
            ContentTemplate="{DataTemplate views:CarKmPage}" />
        </Tab>

        <Tab Title="Car Maintainance">
            <ShellContent
            ContentTemplate="{DataTemplate views:CarMaintainPage}" />
        </Tab>
        
    </TabBar>


</Shell>
