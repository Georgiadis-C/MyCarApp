<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MyCarApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MyCarApp"
    xmlns:views="clr-namespace:MyCarApp.Views"
    Title="MyCarApp"
    Shell.TabBarBackgroundColor="White"
    Shell.TabBarForegroundColor="LightGray"
    Shell.TabBarTitleColor="LightGray">

    <TabBar>
        <Tab Title="Car Page">
            <ShellContent 
            ContentTemplate="{DataTemplate views:CarsPage}" />
        </Tab>

        
    </TabBar>


</Shell>
