<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyCarApp.Components.LoadingOverlay">

    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="15">
       
        <Image Source="loading_slow_net.gif"
               IsAnimationPlaying="True"
               HeightRequest="150"
               WidthRequest="150"/>
        <Label Text="Calculating the meaning of life... and your data. Please wait. 🤖" FontSize="12" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>

    </VerticalStackLayout>
</ContentView>
